#!/usr/bin/env python3
"""Rewrite the moving figures in docs/submission.md from the ledger.

Why this exists, since a script that edits prose deserves a reason.

The submission has to disclose what the project spent. Most of that is fixed —
an invoice, a domain registration, a subscription — but the ledger's own
estimate of model spend rises on every cycle, and `runner/prose_audit.py`
checks money claims against the ledger as it is *now*. So a correct figure,
typed by hand, becomes an audit error within hours.

That is not a hypothetical. Between 13 and 15 August the same number was
written as $12.26, $12.81, $13.29, $13.64 and $13.97, three Jules sessions were
filed to chase it, one pull request was opened proposing a value that was stale
before it was reviewed, and two requests reached the Operator asking what to do.
None of that was wrong work. It was the wrong thing to be doing by hand.

So: read the figures, rewrite the sentences that hold them, and say what
changed. Run it before filing the submission, and after the last cycle you
intend to let run.

    ./bin/refresh-figures            # rewrite, then audit
    ./bin/refresh-figures --check    # report drift, change nothing

Only the numbers move. Every sentence around them is left exactly as written,
which is the point: the argument is the human's, the arithmetic is the ledger's.
"""

from __future__ import annotations

import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from decimal import Decimal
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DOC = ROOT / "docs" / "submission.md"
LEDGER = ROOT / "ledger.db"


def figures() -> dict:
    con = sqlite3.connect(f"file:{LEDGER}?mode=ro", uri=True)
    calls, usd = con.execute(
        "SELECT COUNT(*), ROUND(SUM(usd_est), 2) FROM llm_usage").fetchone()
    roles = dict(con.execute(
        "SELECT COALESCE(key_role, ''), COUNT(*) FROM llm_usage GROUP BY 1"))
    cycles = con.execute("SELECT COUNT(*) FROM cycles").fetchone()[0]

    # Cycles that logged a mid-cycle fallback to the paid key, and how many
    # `ops` calls sit inside one. This is the evidence for the claim that the
    # role column cannot stand in for the key, so it is recomputed rather than
    # left as the number that happened to be true when the paragraph was
    # written.
    fell_back = {r[0] for r in con.execute(
        "SELECT id FROM cycles WHERE handoff LIKE '%fell back to the paid API key%'")}
    ops_in_fallback = sum(
        n for cid, n in con.execute(
            "SELECT cycle_id, COUNT(*) FROM llm_usage "
            "WHERE key_role = 'ops' GROUP BY cycle_id")
        if cid in fell_back)

    # Commit attribution comes from git, not the ledger. It drifts for the same
    # reason and is the same kind of claim: a statement about who did the work.
    def git(*args: str) -> str:
        return subprocess.run(["git", *args], cwd=ROOT, capture_output=True,
                              text=True, check=True).stdout

    commits = int(git("rev-list", "--count", "HEAD").strip())
    authors = git("log", "--format=%an|%(trailers:key=Co-Authored-By,valueonly)")
    coral_commits = sum(1 for l in authors.splitlines() if l.startswith("Coral"))
    co_authored = sum(1 for l in authors.splitlines()
                      if l.startswith("Eliza Zadura|") and "anthropic" in l)

    eliza_commits = sum(1 for l in authors.splitlines()
                        if l.startswith("Eliza Zadura|"))
    # Three commits are the Operator's own typing; everything else was written
    # by something. Held as a constant because it is a judgement about content,
    # not a count — `git log` cannot tell you who typed a commit it attributes
    # to her, which is the entire point of this section.
    HERS = 3
    MERGES = 2
    ratio = round(eliza_commits / HERS)
    WORDS = {20: "twenty", 21: "twenty-one", 22: "twenty-two", 23: "twenty-three",
             24: "twenty-four", 25: "twenty-five", 26: "twenty-six",
             27: "twenty-seven", 28: "twenty-eight", 29: "twenty-nine",
             30: "thirty", 31: "thirty-one", 32: "thirty-two", 33: "thirty-three",
             34: "thirty-four", 35: "thirty-five"}

    return {
        "calls": calls,
        "usd": f"{usd:.2f}",
        "commits": commits,
        "coral_commits": coral_commits,
        "co_authored": co_authored,
        "eliza_commits": eliza_commits,
        "by_software": commits - HERS - MERGES,
        "ratio_word": WORDS.get(ratio, str(ratio)),
        "planning": roles.get("planning", 0),
        "ops": roles.get("ops", 0),
        "unattributed": roles.get("", 0),
        "cycles": cycles,
        "fell_back": len(fell_back),
        "ops_in_fallback": ops_in_fallback,
        "read_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%MZ"),
    }


#: Each rule is (regex, replacement template). The regex must anchor on prose
#: that is not itself a figure, so that rewriting cannot walk: matching "$12.81"
#: to replace it with "$15.62" works once and then the pattern no longer
#: matches. Anchor on the words either side and capture the number.
RULES = [
    (r"(estimate of total model\nspend is \*\*\$)[\d.]+(\*\* across )\d+( calls)",
     r"\g<1>{usd}\g<2>{calls}\g<3>"),
    (r"(paid key when the free key stops serving mid-cycle, and )\d+( of )\d+( cycles logged)",
     r"\g<1>{fell_back}\g<2>{cycles}\g<3>"),
    (r"(that; )\d+( of the )\d+( `ops` calls were made inside one)",
     r"\g<1>{ops_in_fallback}\g<2>{ops}\g<3>"),
    (r"(What the ledger does support, read at )[0-9T:Z-]+(:)",
     r"\g<1>{read_at}\g<2>"),
    (r"(\| `planning` — paid key by design \| )\d+( \|)",
     r"\g<1>{planning}\g<2>"),
    (r"(\| `ops` — free key by design, fell back to paid on )\d+( of )\d+( cycles \| )\d+( \|)",
     r"\g<1>{fell_back}\g<2>{cycles}\g<3>{ops}\g<4>"),
    # The total row is anchored to the row above it, not matched on its own.
    # `| **Total** | **N** |` also appears in the commit-attribution table in
    # §5, and the first version of this script rewrote 78 commits to 665 model
    # calls — silently, in a claim about who wrote the software. It was caught
    # by reading the diff rather than by the script, which is the argument for
    # printing one.
    (r"(\| Recorded before the ledger tracked the role at all \| )\d+( \|\n"
     r"\| \*\*Total\*\* \| \*\*)\d+(\*\* \|)",
     r"\g<1>{unattributed}\g<2>{calls}\g<3>"),

    # Commit attribution, from `git log` rather than the ledger. Same problem,
    # different source: the table said 78 while the repository held 102.
    (r"(\| Operator-directed, Claude Code-written \(carry `Co-Authored-By`\) \| )\d+( \|)",
     r"\g<1>{co_authored}\g<2>"),
    (r"(\| Coral, autonomous \| )\d+( \|\n\| \*\*Total\*\* \| \*\*)\d+(\*\* \|)",
     r"\g<1>{coral_commits}\g<2>{commits}\g<3>"),
    # The sentence under the table restates the same counts in prose. It said
    # "73 of 78" while the table said 102, which is the failure mode of fixing
    # a table and not reading what follows it.
    (r"\*\*\d+ of \d+ commits were written by software\.\*\*",
     r"**{by_software} of {commits} commits were written by software.**"),
    (r"(field credits her with )\d+( — roughly )[a-z-]+( times what she actually typed)",
     r"\g<1>{eliza_commits}\g<2>{ratio_word}\g<3>"),
]


#: A cell holding one figure: optionally bolded, optionally a dollar amount.
_FIGURE = re.compile(r"^\*{0,2}\$?([\d,]+(?:\.\d+)?)\*{0,2}$")


def _cells(line: str) -> list[str]:
    return [c.strip() for c in line.strip().strip("|").split("|")]


def check_totals(text: str) -> list[str]:
    """Report every `**Total**` row that disagrees with the rows above it.

    The rules above rewrite individual cells. Nothing made them agree with each
    other, and on 17 August they did not: §5's table was rewritten to a total of
    109 commits while its rows still summed to 108, because a Jules commit had
    landed as a squash merge — GitHub keeps the pull request title and discards
    the `Co-Authored-By` trailer, so it belonged to a row that is maintained by
    hand and not by `git log`.

    A total that does not equal its parts is the exact failure this script was
    written to prevent, arriving by the one route it was not watching: not a
    stale figure, but two current figures that cannot both be true. Cheap to
    check, so check it — and check the fixed tables too, since arithmetic does
    not care which numbers a script owns.
    """
    lines = text.splitlines()
    problems = []

    for i, line in enumerate(lines):
        cells = _cells(line)
        if not cells or not cells[0].startswith("**Total**"):
            continue
        # Which column carries the figure. Skip column 0, which holds the label.
        col = next((j for j, c in enumerate(cells)
                    if j and _FIGURE.match(c)), None)
        if col is None:
            continue
        want = Decimal(_FIGURE.match(cells[col])[1].replace(",", ""))

        got, rows = Decimal(0), 0
        for k in range(i - 1, -1, -1):
            prev = lines[k].strip()
            if not prev.startswith("|"):
                break
            pc = _cells(prev)
            # A shape change or the `|---|---:|` separator ends the table; so
            # does any non-numeric cell, which is what a header row looks like.
            if len(pc) != len(cells):
                break
            m = _FIGURE.match(pc[col])
            if not m:
                break
            got += Decimal(m[1].replace(",", ""))
            rows += 1

        if rows and got != want:
            problems.append(
                f"line {i + 1}: the {rows} rows above sum to {got}, "
                f"but the total says {want} — off by {want - got}")

    return problems


def main(argv: list[str]) -> int:
    check_only = "--check" in argv
    f = figures()
    before = DOC.read_text()
    after = before
    missed = []

    for pattern, template in RULES:
        new, n = re.subn(pattern, template.format(**f), after)
        if n == 0:
            missed.append(pattern[:52])
        after = new

    if missed:
        # Loudly, and without writing. A rule that stops matching means the
        # prose was edited and a figure is now unmaintained — exactly the state
        # this script exists to prevent, and the worst possible failure is to
        # half-update the document and report success.
        print("A rule matched nothing. The document has been edited around it:",
              file=sys.stderr)
        for m in missed:
            print(f"  {m}…", file=sys.stderr)
        print("\nNothing written. Fix the rule in bin/refresh-figures or the "
              "prose in docs/submission.md.", file=sys.stderr)
        return 2

    if broken := check_totals(after):
        # Before writing, and regardless of --check. Half of a contradiction is
        # a figure this script maintains; the other half is a figure a person
        # maintains, and only the person can say which one is wrong.
        print("A total does not equal the rows above it:", file=sys.stderr)
        for b in broken:
            print(f"  {b}", file=sys.stderr)
        print("\nNothing written. One of those numbers is maintained by hand — "
              "read the table and fix that row, not the total.", file=sys.stderr)
        return 3

    # What actually moved, line by line. One of the rules rewrites the "read at"
    # timestamp, which changes on every run by construction — so comparing whole
    # documents made `--check` report drift every time, including immediately
    # after a rewrite. A drift detector that always fires teaches you to stop
    # reading it, which is worse than not having one.
    bl, al = before.splitlines(), after.splitlines()
    if len(bl) != len(al):
        # Every rule substitutes within a line or preserves the newline it spans,
        # so this cannot happen. If it ever does, `zip` would silently truncate
        # the comparison rather than report it.
        print(f"A rule changed the line count ({len(bl)} → {len(al)}). "
              f"Nothing written.", file=sys.stderr)
        return 4
    moved = [(b, a) for b, a in zip(bl, al) if b != a and "read at" not in b]

    if not moved:
        print(f"Already current: ${f['usd']} across {f['calls']} calls, "
              f"{f['cycles']} cycles.\n"
              f"Left the read timestamp alone — the figures it dates have not "
              f"changed.")
    elif check_only:
        print(f"Drift in {len(moved)} line(s). The ledger now says ${f['usd']} "
              f"across {f['calls']} calls:")
        for b, a in moved:
            print(f"  - {b.strip()}\n  + {a.strip()}")
        print("\nRun without --check to rewrite.")
        return 1
    else:
        DOC.write_text(after)
        print(f"Rewritten from the ledger, read {f['read_at']}:\n"
              f"  ${f['usd']} across {f['calls']} calls\n"
              f"  planning {f['planning']} · ops {f['ops']} · "
              f"unattributed {f['unattributed']}\n"
              f"  {f['fell_back']} of {f['cycles']} cycles fell back to the paid key")

    if check_only:
        return 0

    print("\nAuditing…")
    return subprocess.call(
        [sys.executable, "-m", "runner.prose_audit", str(DOC)], cwd=ROOT)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
